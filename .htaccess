# ===== از AI بپرس (askai) =====
Options -Indexes
DirectoryIndex index.php

<IfModule mod_env.c>
    SetEnv ASKAI_REWRITE 1
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # مهم: هیچ RewriteBase ثابتی نمی‌گذاریم؛ قواعد نسبی هستند تا در زیرپوشه
    # (مثل http://localhost/ai/) هم درست کار کنند.

    # /s/CODE  ->  s.php?c=CODE
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^s/([A-Za-z0-9_-]{3,32})/?$ s.php?c=$1 [L,QSA]

    # /CODE  ->  s.php?c=CODE  (لینک خیلی کوتاه)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !/(assets|data|lib|partials)/
    RewriteRule ^([A-Za-z0-9_-]{3,32})/?$ s.php?c=$1 [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
