# ===== بزار من برات AI کنم (bmbaik.ir) =====
Options -Indexes
DirectoryIndex index.php

<IfModule mod_env.c>
    SetEnv ASKAI_REWRITE 1
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # مهم: هیچ RewriteBase ثابتی نمی‌گذاریم؛ قواعد نسبی هستند تا در زیرپوشه
    # (مثل http://localhost/ai/) هم درست کار کنند.

    # /s/CODE  ->  s.php?c=CODE
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^s/([A-Za-z0-9_-]{3,32})/?$ s.php?c=$1 [L,QSA]

    # /CODE  ->  s.php?c=CODE  (لینک خیلی کوتاه)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !/(assets|data|lib|partials)/
    RewriteRule ^([A-Za-z0-9_-]{3,32})/?$ s.php?c=$1 [L,QSA]

    # هر مسیر دیگری که وجود ندارد -> صفحهٔ خطای زیبای 404
    # (این قاعده نسبی است و در زیرپوشه هم کار می‌کند)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ error.php?code=404 [L,QSA]
</IfModule>

# صفحات خطای سفارشی آپاچی
# توجه: مسیر ErrorDocument از ریشهٔ دامنه حساب می‌شود.
# اگر پروژه در زیرپوشه است، به این شکل اصلاح کن: /ai/error.php
ErrorDocument 400 /error.php
ErrorDocument 401 /error.php
ErrorDocument 403 /error.php
ErrorDocument 404 /error.php
ErrorDocument 405 /error.php
ErrorDocument 408 /error.php
ErrorDocument 413 /error.php
ErrorDocument 429 /error.php
ErrorDocument 500 /error.php
ErrorDocument 502 /error.php
ErrorDocument 503 /error.php
ErrorDocument 504 /error.php

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
